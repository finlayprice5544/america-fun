4:["$","p",null,{"children":["We may update this Privacy Notice based upon evolving laws, regulations, and industry standards, or as we make changes to the"," ",["$","strong",null,{"children":"America.Fun Platform"}],". If we make changes that materially alter your privacy rights, we will take appropriate measures to inform you, consistent with the significance of the changes we make. If you disagree with the changes to this Privacy Notice, you should discontinue your access and use of the"," ",["$","strong",null,{"children":"America.Fun Platform"}],"."]}]
5:["$","p",null,{"children":["Our Site and the ",["$","strong",null,{"children":"America.Fun Platform"}]," are not directed to, and we do not knowingly collect Personal Data from, anyone under the age of 18. If a parent or guardian becomes aware that his or her child has provided us with information, they should contact us. We will delete such information from our files as soon as reasonably practicable."]}]
6:["$","p",null,{"children":["$","strong",null,{"children":"Data Controller"}]}]
7:["$","p",null,{"children":"For the purposes of applicable data protection laws, the data controller is the America.Fun entity responsible for operating the Platform, as identified in the Terms of Use. References to \"America.Fun\" include such entity and its affiliates where applicable."}]
8:["$","h2",null,{"children":"Definition of Personal Data"}]
9:["$","p",null,{"children":"The term \"Personal Data\" as used in this policy describes information that can be associated with a specific person and can identify that person. Personal Data does not include information that has been aggregated or anonymized so that a specific person can no longer be identified. Any reference to \"Personal Data\" in this Privacy Notice includes, without limitation, \"Personal Data\" as defined under applicable data protection laws, including the UK Data Protection Act 2018 and GDPR."}]
a:["$","h2",null,{"children":"Types of Personal Data Collected"}]
b:["$","p",null,{"children":"The types of Personal Data that we may collect from you or through third parties will depend on our interactions with you and may include:"}]
c:["$","ul",null,{"children":[["$","li",null,{"children":"Financial information such as your wallet addresses;"}],["$","li",null,{"children":["Transaction information such as the wallet addresses of senders and recipients of Digital Assets, activities on the"," ",["$","strong",null,{"children":"America.Fun Platform"}],", your inquiries and our responses;"]}],["$","li",null,{"children":["Usage Data including your IP address, country of origin, browser or operating system features, and activity logs on the"," ",["$","strong",null,{"children":"America.Fun Platform"}],";"]}],["$","li",null,{"children":["Other personal, commercial, or identification information we may be required to collect ",["$","strong",null,{"children":"where applicable"}]," to comply with legal or regulatory obligations."]}]]}]
d:["$","p",null,{"children":"We may also collect Personal Data about you from third parties and publicly available sources."}]
e:["$","p",null,{"children":["We collect this information from you when you freely provide it on the ",["$","strong",null,{"children":"America.Fun Platform"}]," or when you use the Platform. We may also collect Personal Data from third parties or publicly available sources as noted above."]}]
f:["$","p",null,{"children":"Unless otherwise specified, certain Personal Data may be required to provide specific features or comply with legal obligations. Failure to provide required data may limit access to particular features or Services."}]
10:["$","h2",null,{"children":"Information We Automatically Collect"}]
11:["$","p",null,{"children":["When you visit the ",["$","strong",null,{"children":"America.Fun Platform"}],", we may automatically collect certain information about your device, including browser type, IP address, device ID, timezone, and location information using cookies and similar technologies. We may also collect data on how you interact with the Site, including pages viewed, referrers, and search terms."]}]
12:["$","h2",null,{"children":"Cookies & Similar Technologies"}]
13:["$","p",null,{"children":"We use cookies (small, often encrypted text files stored on your device) and similar technologies (\"Cookies\") to provide certain platform functionality and help collect data."}]
14:["$","h3",null,{"children":"How We Use Cookies"}]
15:["$","p",null,{"children":"We use Cookies to:"}]
16:["$","ul",null,{"children":[["$","li",null,{"children":["Track how you use the ",["$","strong",null,{"children":"America.Fun Platform"}],";"]}],["$","li",null,{"children":"Provide usage statistics;"}],["$","li",null,{"children":"Authenticate users and remember preferences."}]]}]
17:["$","p",null,{"children":["We do ",["$","strong",null,{"children":"not"}]," combine or link cookie data with third-party data for advertising purposes or share cookie-based data with data brokers."]}]
