33:["$","h3",null,{"children":"Data Security"}]
34:["$","p",null,{"children":["We employ administrative, technical, and physical safeguards to protect Personal Data. However, transmission of data over the internet is never completely secure. You use the"," ",["$","strong",null,{"children":"America.Fun Platform"}]," at your own risk."]}]
35:["$","h3",null,{"children":"Blockchain Transactions"}]
36:["$","p",null,{"children":"Your use of digital assets may be recorded on public blockchains, which are immutable and beyond our control. We cannot erase or modify data recorded on such blockchains."}]
37:["$","h2",null,{"children":"Overseas Disclosure and Your Privacy Rights"}]
38:["$","p",null,{"children":["For data protection purposes, ",["$","strong",null,{"children":"America.Fun"}]," is the data controller. Your Personal Data may be processed in jurisdictions outside your residence. We ensure adequate protection via appropriate safeguards such as standard contractual clauses or equivalent mechanisms where required."]}]
39:["$","p",null,{"children":"Residents of the EEA and UK have the right to:"}]
