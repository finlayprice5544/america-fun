3b:["$","p",null,{"children":["Requests can be made through ",["$","strong",null,{"children":"America.Fun Support"}],". We aim to respond to verified requests within one month of receipt, or within such other timeframe as permitted under applicable data protection law."]}]
3c:["$","h2",null,{"children":"General"}]
3d:["$","p",null,{"children":"If you wish to exercise your rights, contact Support and provide sufficient identifying information and details of your request. We will process verified requests in accordance with applicable law."}]
