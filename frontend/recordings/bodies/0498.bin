1a:["$","h3",null,{"children":"How to Control Cookies"}]
1b:["$","p",null,{"children":"You may control, block, or delete Cookies via your browser settings. Note that disabling Cookies may impair Platform Functionality."}]
1c:["$","h2",null,{"children":"Google Analytics"}]
1d:["$","p",null,{"children":["We may use Google Analytics to help analyze how you use our Site. Google Analytics generates reports through cookies about Site usage, which Google stores. If you wish to opt out, you can install the"," ",["$","a",null,{"href":"https://tools.google.com/dlpage/gaoptout","className":"text-blue-600 underline","children":"Google Analytics opt-out browser add-on"}],"."]}]
1e:["$","p",null,{"children":"Google Analytics may process data on servers outside your jurisdiction. We configure Google Analytics in accordance with applicable data protection requirements, including IP anonymization where required."}]
1f:["$","h2",null,{"children":"Method and Basis of Processing Data"}]
20:["$","h3",null,{"children":"Methods of Processing"}]
21:["$","p",null,{"children":"We take appropriate security measures to prevent unauthorized access, disclosure, modification, or destruction of data. Processing is performed using IT-enabled tools, following organizational procedures related to stated purposes."}]
22:["$","p",null,{"children":"Data may be accessible to certain internal and external parties (administration, legal, IT, hosting providers, technical partners). You may request a list of these parties at any time."}]
23:["$","h3",null,{"children":"Legal Basis of Processing"}]
24:["$","p",null,{"children":"We may process Personal Data if one or more of the following apply:"}]
25:["$","ul",null,{"children":[["$","li",null,{"children":"You have given consent for one or more specific purposes;"}],["$","li",null,{"children":"Processing is necessary for performance of an agreement with you;"}],["$","li",null,{"children":"Processing is necessary for compliance with a legal obligation;"}],["$","li",null,{"children":"Processing is necessary for our or a third party's legitimate interests."}]]}]
26:["$","h2",null,{"children":"How We Use Personal Data"}]
27:["$","p",null,{"children":"Data collected about you is used to:"}]
