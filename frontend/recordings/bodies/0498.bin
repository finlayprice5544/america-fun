2b:["$","ul",null,{"children":[["$","li",null,{"children":["Service providers and vendors assisting in operating the"," ",["$","strong",null,{"children":"America.Fun Platform"}],";"]}],["$","li",null,{"children":"Affiliates, for internal purposes consistent with this Privacy Notice;"}],["$","li",null,{"children":"Third-party companies providing services on our behalf;"}],["$","li",null,{"children":"Regulators or authorities for compliance or legal reasons;"}],["$","li",null,{"children":"Business partners or acquirers in connection with a merger, acquisition, or asset sale, subject to confidentiality and applicable data protection requirements."}]]}]
2c:["$","p",null,{"children":"We do not sell your Personal Data."}]
2d:["$","h2",null,{"children":"Retention of Personal Data"}]
2e:["$","p",null,{"children":"We retain Personal Data only as long as necessary for the purposes described herein or as required by law. Once the retention period expires, Personal Data will be deleted or de-identified, except where blockchain-based records make erasure impossible."}]
2f:["$","p",null,{"children":"We do not retain Personal Data longer than reasonably necessary, taking into account technical constraints of blockchain technology."}]
